save-exact=true
strict-peer-dependencies=true
auto-install-peers=false
engine-strict=true
# GVS G9 (J230): install into pnpm's global virtual store. confirm-modules-purge=false lets an
# existing classic checkout move over on a non-TTY install. allowBuilds (SA39) lives in package.json.
enable-global-virtual-store=true
confirm-modules-purge=false
