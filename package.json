{
  "name": "@wildshard/shard-showcase",
  "version": "0.0.0",
  "private": true,
  "description": "The Showcase: a Wildshard shard.",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "lint": "pnpm lint:shards && node kit/scripts/lint.mjs --type-aware --deny-warnings --ignore-pattern '.githooks/**' --ignore-pattern '.agents/**' --ignore-pattern 'scripts/agent-parity.mjs' --ignore-pattern 'scripts/agent-sync.mjs' --ignore-pattern 'tmp/**' --ignore-pattern 'src/shards/**' --ignore-pattern 'src/test/.kit/**' --ignore-pattern 'scripts/**' --no-error-on-unmatched-pattern",
    "lint:fix": "node kit/scripts/lint.mjs --type-aware --fix --ignore-pattern '.githooks/**' --ignore-pattern '.agents/**' --ignore-pattern 'scripts/agent-parity.mjs' --ignore-pattern 'scripts/agent-sync.mjs' --ignore-pattern 'tmp/**'",
    "format": "npr oxfmt -c kit/.oxfmtrc.json kit '!src/shards/**' '!src/test/.kit/**' '!.oxlintrc.author.json'",
    "format:check": "npr oxfmt -c kit/.oxfmtrc.json --check kit '!src/shards/**' '!src/test/.kit/**' '!.oxlintrc.author.json'",
    "check:asks": "node kit/scripts/asks.mjs check",
    "check:agents": "node .githooks/agents-md.mjs lint",
    "check:parity": "node scripts/agent-parity.mjs --strict",
    "check:agent-sync": "node scripts/agent-sync.mjs --check",
    "test:agent-hooks": "node --test '.agents/hooks/test/*.test.mjs'",
    "agents:sync": "node scripts/agent-sync.mjs",
    "md:wrap": "node kit/scripts/md-wrap.mjs",
    "test:hooks": "node --test '.githooks/*.test.mjs'",
    "check": "pnpm check:bin-pins && pnpm lint && pnpm format:check && pnpm check:asks && pnpm check:agents && pnpm check:agent-sync && pnpm test:agent-hooks && pnpm check:parity && node --check scripts/chromium-keychain-check.mjs && node --test src/test/.kit/chrome-keychain.test.mjs src/test/.kit/lane-live.test.mjs src/test/.kit/leftovers-report.test.mjs",
    "build:shards": "node scripts/publish-public.mjs && wildshard build-shards",
    "pack:shards": "node scripts/pack-all.mjs",
    "lint:shards": "node kit/scripts/bin-tools.mjs -c .oxlintrc.author.json --deny-warnings --no-error-on-unmatched-pattern src/shards --ignore-pattern 'src/scripts/**'",
    "check:bin-pins": "node kit/scripts/bin-pins.mjs"
  },
  "dependencies": {
    "@wildshard/format": "npm:@wildshard/shard-format@0.43.0",
    "@wildshard/sdk": "0.4.12",
    "three": "0.186.0",
    "valibot": "1.5.0",
    "@wildshard/cli": "0.4.12"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "oxlint": "1.89.0",
    "vite": "8.3.0",
    "npm-bin-deps": "2.1.0"
  },
  "binDependencies": {
    "typescript": "7.0.2",
    "oxfmt": "0.74.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "binDependenciesInstaller": "npm"
}
